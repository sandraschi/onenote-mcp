# onenote-mcp environment template
# Copy to .env and fill in your credentials. Never commit .env.

# Microsoft Graph access token (optional - use the authenticate tool or
# Settings page device-code flow instead if not provided)
GRAPH_ACCESS_TOKEN=

# Entra app (client) ID: EVERY user registers their own free app (the borrowed Graph Explorer
# ID is gone: the OneNote workload rejects its tokens). The app UI guides this and stores it in
# the app-data folder; set it here only to override (developers). See docs/ONBOARDING.md.
ONENOTE_CLIENT_ID=

# Entra authority. Personal-accounts-only apps MUST use /consumers
# (AADSTS9002346 otherwise); multi-tenant apps use /common.
ONENOTE_AUTHORITY=https://login.microsoftonline.com/common

# Backend host/port (Tauri + PyInstaller sidecar use these)
ONENOTE_HOST=127.0.0.1
ONENOTE_PORT=10907
ONENOTE_LOG_LEVEL=info

# MCP transport (stdio | http | sse)
MCP_TRANSPORT=http
